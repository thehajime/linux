define walk_list
	set $temp = $arg0
	while ($temp)
	printf "(%d,0x%X)-->",((sll*)$temp)->data,((sll*)$temp)->next
	set $temp = ((sll*)$temp)->next
	end
	printf "Done\n"
end

define walk_tailq
